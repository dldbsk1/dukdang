import SwiftUI

struct AuctionContentView: View {
    let item: TradePostItem
    @State private var showBidSheet = false
    @State private var isLiked: Bool = false
    
    // 실시간 타이머 변수
    @State private var timeRemaining: String = ""
    let timer = Timer.publish(every: 1, on: .main, in: .common).autoconnect()
    
    var body: some View {
        VStack(spacing: 0) {
            ScrollView {
                VStack(alignment: .leading, spacing: 0) {
                    // 상단 이미지 영역
                    Rectangle()
                        .fill(Color.gray.opacity(0.1))
                        .frame(height: 300)
                        .overlay(
                            Image(systemName: "sparkles")
                                .font(.system(size: 80))
                                .foregroundColor(.red.opacity(0.4))
                        )
                    
                    VStack(alignment: .leading, spacing: 12) {
                        // 판매자 정보
                        HStack {
                            Image(systemName: "person.circle.fill")
                                .resizable()
                                .frame(width: 40, height: 40)
                                .foregroundColor(.gray.opacity(0.5))
                            
                            VStack(alignment: .leading) {
                                Text(item.sellerNickname).font(.headline)
                                Text("인증된 판매자").font(.caption).foregroundColor(.gray)
                            }
                            Spacer()
                        }
                        .padding(.vertical, 8)
                        
                        Divider()
                        
                        badgeView(for: item.status)
                        
                        VStack(alignment: .leading, spacing: 8) {
                            Text(item.title).font(.title3).bold()
                            
                            HStack {
                                Text(item.category).font(.caption)
                                Text("•")
                                // ✅ 이제 postTime을 원래 용도(방금 전 등)로 사용 가능
                                Text(relativeTimeString(from: item.postTime)).font(.caption)
                            }
                            .foregroundColor(.secondary)
                        }
                        
                        Text("상품 설명이 들어가는 자리입니다. 실제 앱에서는 상세한 경매 규칙과 물품 상태를 적어주세요.")
                            .font(.body).padding(.vertical, 10)
                        
                        // ✅ 수정된 타이머 섹션: item.endTime이 있을 때만 표시
                        if let endTime = item.endTime, item.status == "RESERVED" {
                            HStack {
                                Spacer()
                                Image(systemName: "stopwatch.fill")
                                Text(timeRemaining.isEmpty ? "계산 중..." : timeRemaining)
                                    .fontWeight(.bold)
                                Spacer()
                            }
                            .font(.system(size: 18))
                            .foregroundColor(.orange)
                            .padding(.vertical, 10)
                            .background(Color.orange.opacity(0.08))
                            .cornerRadius(10)
                            .onReceive(timer) { _ in
                                // ✅ item.endTime을 사용하여 타이머 갱신
                                self.timeRemaining = calculateTimeRemaining(until: endTime)
                            }
                        }

                        // 가격 표시 박스
                        HStack {
                            Spacer()
                            Text("시작가").font(.title3).foregroundColor(.gray)
                            Spacer()
                            Text("\(formatPrice(item.price))원")
                                .font(.title).bold()
                            Spacer()
                        }
                        .padding().background(Color.gray.opacity(0.1)).cornerRadius(10)
                        
                        Text("조회 \(item.viewCount)").font(.caption).foregroundColor(.gray).padding(.top, 5)
                    }
                    .padding()
                }
            }
            
            Divider()
            
            // 하단 바 (입찰 버튼 등)
            HStack {
                VStack(alignment: .center) {
                    Button(action: { isLiked.toggle() }) {
                        Image(systemName: isLiked ? "heart.fill" : "heart")
                            .font(.title2)
                            .foregroundColor(isLiked ? .red : .gray)
                    }
                    Text("\(item.wishCount + (isLiked ? 1 : 0))")
                        .font(.caption)
                        .foregroundColor(.gray)
                }
                
                Spacer().frame(width: 20)
                
                Button(action: {
                    showBidSheet = true
                }) {
                    Text(item.status == "SOLD" ? "경매 종료" : "가격 올리기")
                        .font(.title2).foregroundColor(.white)
                        .frame(maxWidth: .infinity).padding()
                        .background(item.status == "SOLD" ? Color.gray : Color.red)
                        .cornerRadius(8)
                }
                .disabled(item.status == "SOLD")
            }
            .padding()
        }
        .navigationTitle("상세 정보")
        .navigationBarTitleDisplayMode(.inline)
        .onAppear {
            // ✅ 초기화 시 endTime 사용
            if let endTime = item.endTime {
                self.timeRemaining = calculateTimeRemaining(until: endTime)
            }
        }
        .sheet(isPresented: $showBidSheet) {
            BidSheetView(currentPrice: item.price, isPresented: $showBidSheet)
        }
    }
    
    // ✅ 타이머 계산 로직 (endTime 기준)
    private func calculateTimeRemaining(until dateString: String) -> String {
        let formatter = ISO8601DateFormatter()
        guard let endDate = formatter.date(from: dateString) else { return "시간 정보 없음" }
        
        let diff = Int(endDate.timeIntervalSinceNow)
        if diff <= 0 { return "경매가 종료되었습니다" }
        
        let days = diff / 86400
        let hours = (diff % 86400) / 3600
        let minutes = (diff % 3600) / 60
        let seconds = diff % 60
        
        if days > 0 {
            return "마감까지 \(days)일 \(hours)시간"
        } else {
            return String(format: "마감까지 %02d:%02d:%02d", hours, minutes, seconds)
        }
    }

    // 기존 뱃지 뷰, 포맷 함수들 유지
    @ViewBuilder
    private func badgeView(for statusString: String) -> some View {
        if let status = TradeStatus(rawValue: statusString), status != .SALE {
            let badgeInfo: (text: String, color: Color) = {
                switch status {
                case .RESERVED: return ("진행중", .red)
                case .SOLD: return ("거래완료", .gray)
                default: return ("", .clear)
                }
            }()
            Text(badgeInfo.text).font(.system(size: 11, weight: .bold)).foregroundColor(.white)
                .padding(.horizontal, 8).padding(.vertical, 4).background(badgeInfo.color).cornerRadius(4)
        }
    }
    
    private func formatPrice(_ price: Int) -> String {
        let formatter = NumberFormatter()
        formatter.numberStyle = .decimal
        return formatter.string(from: NSNumber(value: price)) ?? "\(price)"
    }

    func relativeTimeString(from dateString: String) -> String {
        let formatter = ISO8601DateFormatter()
        guard let date = formatter.date(from: dateString) else { return "방금 전" }
        let now = Date()
        let components = Calendar.current.dateComponents([.minute, .hour, .day], from: date, to: now)
        if let day = components.day, day > 0 { return "\(day)일 전" }
        if let hour = components.hour, hour > 0 { return "\(hour)시간 전" }
        if let minute = components.minute, minute > 0 { return "\(minute)분 전" }
        return "방금 전"
    }
}

// MARK: - 가격 올리기 바텀 시트
struct BidSheetView: View {
    let currentPrice: Int
    @Binding var isPresented: Bool
    @State private var bidInput: String = ""
    let quickBids = [100, 500, 1000, 5000]
    
    var body: some View {
        VStack(spacing: 20) {
            Text("가격 올리기")
                .font(.headline)
                .padding(.top)
            
            HStack {
                Text("현재 최고가")
                    .foregroundColor(.gray)
                Text("\(formatPrice(currentPrice))원")
                    .bold()
            }
            
            Divider()
            
            HStack(spacing: 10) {
                ForEach(quickBids, id: \.self) { amount in
                    Button(action: {
                        bidInput = "\(currentPrice + amount)"
                    }) {
                        Text("+\(formatPrice(amount))원")
                            .font(.caption)
                            .padding(8)
                            .background(Color.red.opacity(0.1))
                            .foregroundColor(.red)
                            .cornerRadius(8)
                    }
                }
            }
            
            HStack {
                TextField("직접 입력", text: $bidInput)
                    .keyboardType(.numberPad)
                    .padding()
                    .background(Color.gray.opacity(0.1))
                    .cornerRadius(8)
                Text("원")
                    .foregroundColor(.gray)
            }
            .padding(.horizontal)
            
            Button(action: {
                // 여기서 실제 입찰 로직을 구현할 수 있습니다.
                isPresented = false
            }) {
                Text("입찰하기")
                    .font(.title3).bold().foregroundColor(.white)
                    .frame(maxWidth: .infinity).padding()
                    .background(Color.red).cornerRadius(12)
            }
            .padding(.horizontal)
            .padding(.bottom)
        }
        .presentationDetents([.medium]) // 시트 높이를 중간 정도로 조절
    }
    
    private func formatPrice(_ price: Int) -> String {
        let formatter = NumberFormatter()
        formatter.numberStyle = .decimal
        return formatter.string(from: NSNumber(value: price)) ?? "\(price)"
    }
}

